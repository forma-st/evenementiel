# Base PostgreSQL (Neon via Vercel, ou Postgres local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evenementiel"
# Secret de session : 32 caractères aléatoires minimum (obligatoire en production)
SESSION_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-de-32-caracteres"
# Facultatif : code exigé pour créer le premier compte administrateur sur /setup
SETUP_TOKEN=""
# Adresse publique du site (liens dans les e-mails, devis, galeries). Sur Vercel, facultatif.
APP_URL="http://localhost:3000"
# E-mails (resend.com). Vides = mode simulation (e-mails enregistrés, non envoyés)
RESEND_API_KEY=""
MAIL_FROM="Mon Studio <contact@mondomaine.fr>"
# Photos et fichiers : Vercel Blob (ajouté automatiquement en connectant un Blob Store). Vide = disque local (dossier STORAGE_DIR)
BLOB_READ_WRITE_TOKEN=""
STORAGE_DIR="storage"
# Automatisations quotidiennes (Vercel Cron) : longue chaîne aléatoire
CRON_SECRET=""
# Nombre de prestations simultanées possibles le même jour (widget de disponibilité public)
MAX_EVENTS_PER_DAY="1"
# Paiement en ligne (stripe.com) : clé secrète et secret de signature du webhook /api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
